# ─────────────────────────────────────────────────────────────────────────────
# HumanProxy — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# This file is used by:
#   - docker-compose.yml (variable interpolation)
#   - apps/backend (via dotenv in prisma.config.ts and NestJS ConfigModule)
#   - apps/frontend (NEXT_PUBLIC_* vars at build time)
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=humanproxy
POSTGRES_PASSWORD=humanproxy
POSTGRES_DB=humanproxy
# For local dev (host networking): use localhost
# For Docker Compose:              the compose file builds the URL from the above vars
DATABASE_URL=postgresql://humanproxy:humanproxy@localhost:5432/humanproxy

# ── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=humanproxy

# ── Backend ────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
NODE_ENV=production
JWT_SECRET=change-me-in-production
INITIAL_USER_EMAIL=admin@humanproxy.local
INITIAL_USER_PASSWORD=changeme
# CORS: leave empty or '*' to allow all origins (dev).
# In production set to comma-separated allowed origins, e.g.:
#   CORS_ORIGIN=https://app.humanproxy.ai,https://admin.humanproxy.ai
CORS_ORIGIN=

# ── Frontend ────────────────────────────────────────────────────────────────
# Used by Next.js rewrites to proxy /api/* to backend (SSR / Docker internal)
INTERNAL_API_URL=http://localhost:3001

# Browser-accessible backend URL for WebSocket connections.
# Next.js rewrites do NOT upgrade to WebSocket, so the browser must reach the
# backend directly. Set this to the publicly reachable backend URL.
# Local dev:  http://localhost:3001
# Docker:     override in .env (e.g. http://your-server:3001)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Publicly reachable URL of the frontend (used for redirects, CORS, etc.)
# Local dev:  http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Required for browser push notifications (Service Worker + Push API).
# Without these, notifications fall back to in-page only (unreliable in
# background tabs).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@humanproxy.local
