# ##########
# Placet — Environment Configuration
# ##########
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# This file is used by:
#   - docker-compose.yml (variable interpolation)
#   - apps/backend (via dotenv in prisma.config.ts and NestJS ConfigModule)
#   - apps/frontend (NEXT_PUBLIC_* vars at build time)
# ##########

# #### PostgreSQL
POSTGRES_USER=placet
POSTGRES_PASSWORD=placet
POSTGRES_DB=placet
# For local dev (host networking): use localhost
# For Docker Compose:              the compose file builds the URL from the above vars
DATABASE_URL=postgresql://placet:placet@localhost:5432/placet

# #### MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=placet

# #### Backend
BACKEND_PORT=3001
NODE_ENV=production
JWT_SECRET=change-me-in-production
# Log format: 'pretty' (default, human-readable with colors) or 'json' (structured, for monitoring)
LOG_FORMAT=pretty
# Log level: 'debug', 'info' (default), 'warn', 'error'
# LOG_LEVEL=info
INITIAL_USER_EMAIL=admin@placet.local
INITIAL_USER_PASSWORD=changeme
# CORS: leave empty or '*' to allow all origins (dev).
# In production set to comma-separated allowed origins, e.g.:
#   CORS_ORIGIN=https://app.placet.io,https://admin.placet.io
CORS_ORIGIN=
# Allow plugins to fetch local/internal URLs (SSRF protection bypass).
# Only set to 'true' if plugins need to reach services on your local network.
ALLOW_PLUGIN_LOCAL_FETCH=false

# Strict SSRF guard for the agent management proxy (`managementUrl`).
# Default OFF: private addresses (localhost, 10/8, 172.16/12, 192.168/16,
# link-local, ULA, …) are allowed so deployments where Placet talks to facio
# instances on the same Docker network or host work out of the box.
# Set to 'strict' (or 'on'/'true'/'1') when management URLs are user-supplied
# and the backend can reach untrusted internal endpoints.
# MANAGEMENT_SSRF_GUARD=strict

# #### Frontend
# Used by Next.js rewrites to proxy /api/* to backend (SSR / Docker internal)
INTERNAL_API_URL=http://localhost:3001

# Browser-accessible backend URL for WebSocket connections.
# Next.js rewrites do NOT upgrade to WebSocket, so the browser must reach the
# backend directly. Set this to the publicly reachable backend URL.
# Local dev:  http://localhost:3001
# Docker:     override in .env (e.g. http://your-server:3001)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Publicly reachable URL of the frontend (used for redirects, CORS, etc.)
# Local dev:  http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# #### Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
# Required for browser push notifications (Service Worker + Push API).
# Without these, notifications fall back to in-page only (unreliable in
# background tabs).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@placet.local

# #### Traefik (optional — used with docker-compose.traefik.yml)
# Uncomment and set these when deploying with Traefik reverse proxy.
# See "Production Deployment with Traefik" in README.md.
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# DOMAIN=placet.example.com
# ACME_EMAIL=admin@example.com
