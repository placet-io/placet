{
  "name": "hello-world",
  "displayName": "Hello World",
  "description": "A minimal example plugin to demonstrate the plugin structure",
  "version": "1.0.0",
  "author": "HumanProxy",
  "icon": "hand-wave",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Name to greet"
      },
      "emoji": {
        "type": "string",
        "description": "Optional emoji to display"
      }
    },
    "required": ["name"]
  },
  "permissions": {
    "httpRequests": false
  }
}
