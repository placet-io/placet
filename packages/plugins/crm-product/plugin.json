{
  "name": "crm-product",
  "displayName": "CRM Product Card",
  "description": "Renders product details fetched from an external CRM API",
  "version": "1.0.0",
  "author": "HumanProxy",
  "icon": "package",
  "inputSchema": {
    "type": "object",
    "properties": {
      "productId": {
        "type": "string",
        "description": "Product ID to look up"
      },
      "apiBaseUrl": {
        "type": "string",
        "format": "uri",
        "description": "CRM API base URL"
      }
    },
    "required": ["productId"]
  },
  "permissions": {
    "httpRequests": true,
    "maxHttpDomains": ["*"]
  }
}
