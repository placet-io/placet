{
  "name": "status-badge",
  "displayName": "Status Badge",
  "description": "Renders a colored status badge with label and optional details",
  "version": "1.0.0",
  "author": "HumanProxy",
  "icon": "badge-check",
  "inputSchema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "description": "Badge label text"
      },
      "variant": {
        "type": "string",
        "enum": ["success", "warning", "error", "info", "neutral"],
        "description": "Visual variant"
      },
      "details": {
        "type": "string",
        "description": "Optional detail text shown below the badge"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "Optional link URL"
      }
    },
    "required": ["label", "variant"]
  },
  "permissions": {
    "httpRequests": false
  }
}
