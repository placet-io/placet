# ─────────────────────────────────────────────────────────────────────────────
# Placet + OpenClaw — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .env and adjust as needed:
#   cp .env.example .env
#
# The PLACET_API_KEY is shared between Placet and OpenClaw.
# Placet provisions it on boot; OpenClaw reads it as env var.
# Generate a key: node -e "console.log('hp_'+require('crypto').randomBytes(24).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared API Key (REQUIRED — must start with hp_) ──────────────────────
PLACET_API_KEY=hp_change-me-generate-a-real-key

# ── Placet ────────────────────────────────────────────────────────────────
JWT_SECRET=openclaw-local-dev-secret
INITIAL_USER_EMAIL=admin@placet.local
INITIAL_USER_PASSWORD=changeme

# ── OpenClaw ──────────────────────────────────────────────────────────────
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_PORT=8081
PLACET_AGENT_NAME=OpenClaw Agent
