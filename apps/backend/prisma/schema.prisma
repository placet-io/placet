generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  role         String   @default("member") // 'owner' | 'member'
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt    DateTime @default(now()) @map("created_at")

  agents      Agent[]
  apiKeys     ApiKey[]
  apiLogs     ApiLog[]
  channelReads      ChannelRead[]
  pushSubscriptions PushSubscription[]
  preferences       UserPreferences?

  @@map("users")
}

model Agent {
  id           String    @id @default(cuid())
  ownerId      String    @map("owner_id")
  name         String
  description  String?
  avatarUrl    String?   @map("avatar_url")
  webhookUrl     String?   @map("webhook_url") // default webhook for this chat
  webhookHeaders Json?     @map("webhook_headers") // custom headers as { key: value }
  webhookAuth    Json?     @map("webhook_auth") // basic auth as { username, password }
  status         String    @default("offline") // 'active' | 'busy' | 'error' | 'offline'
  statusMessage  String?   @map("status_message")
  statusSince    DateTime? @map("status_since")
  lastActiveAt   DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages       Message[]
  attachments    Attachment[]
  statusHistory  AgentStatusHistory[]
  channelReads   ChannelRead[]

  @@map("agents")
}

model AgentStatusHistory {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  status    String   // 'active' | 'busy' | 'error' | 'offline'
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt(sort: Desc)], name: "idx_agent_status_history")
  @@map("agent_status_history")
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String   @default("Default")
  keyHash   String   @unique @map("key_hash")
  keyPrefix String   @map("key_prefix") // first 11 chars for display: "hp_a3f8..."
  lastUsedAt DateTime? @map("last_used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiLogs ApiLog[]

  @@index([userId], name: "idx_api_keys_user")
  @@map("api_keys")
}

model Message {
  id         String   @id @default(cuid())
  channelId  String   @map("channel_id") // = agent_id
  senderType String   @map("sender_type") // 'agent' | 'user'
  senderId   String   @map("sender_id")
  text       String? // markdown content, nullable for pure attachments
  status     String? // 'info' | 'success' | 'warning' | 'error'
  review     Json? // Review object (see plan)
  metadata   Json? // free-form additional data
  createdAt  DateTime @default(now()) @map("created_at")

  agent       Agent        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([channelId, createdAt(sort: Desc)], name: "idx_messages_channel")
  @@map("messages")
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String?  @map("message_id") // nullable: orphan files stored without a message
  channelId  String   @map("channel_id") // direct link to agent for ownership queries
  pluginType String   @map("plugin_type") // e.g. '@uax/image', '@uax/pdf'
  filename   String
  mimeType   String   @map("mime_type")
  size       BigInt
  storageKey String   @map("storage_key") // MinIO object key
  pluginData Json?    @map("plugin_data") // plugin-specific metadata
  createdAt  DateTime @default(now()) @map("created_at")

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent   Agent    @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId], name: "idx_attachments_channel")
  @@map("attachments")
}

model InstalledPlugin {
  id          String   @id @default(cuid())
  npmName     String   @unique @map("npm_name")
  version     String
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now()) @map("installed_at")

  @@map("installed_plugins")
}

model ApiLog {
  id           String   @id @default(cuid())
  apiKeyId     String?  @map("api_key_id")
  userId       String   @map("user_id")
  method       String // 'POST' | 'GET' | 'DELETE'
  path         String
  requestBody  Json?    @map("request_body")
  responseBody Json?    @map("response_body")
  statusCode   Int      @map("status_code")
  durationMs   Int      @map("duration_ms")
  direction    String // 'inbound' | 'outbound'
  createdAt    DateTime @default(now()) @map("created_at")

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], name: "idx_api_logs_user")
  @@map("api_logs")
}

model UserPreferences {
  userId    String   @id @map("user_id")
  theme     String   @default("system") // 'light' | 'dark' | 'system'
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ChannelRead {
  userId     String   @map("user_id")
  channelId  String   @map("channel_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@map("channel_reads")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_push_subscriptions_user")
  @@map("push_subscriptions")
}
